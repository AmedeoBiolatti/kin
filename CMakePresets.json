    },
    {
      "name": "hex-minimal-x11",
      "configurePreset": "hex-minimal-x11"
    },
    {
      "name": "hex-shipping",
      "configurePreset": "hex-shipping"
    },
    {
      "name": "signal-siege-reference",
      "configurePreset": "signal-siege-reference"
    },
    {
      "name": "signal-siege-shipping",
      "configurePreset": "signal-siege-shipping"
