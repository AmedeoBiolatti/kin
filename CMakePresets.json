    {
      "name": "signal-siege-pgo-use",
      "configurePreset": "signal-siege-pgo-use",
      "targets": [
        "signal_siege_package"
      ]
    },
    {
      "name": "signal-siege-release-linux",
      "configurePreset": "signal-siege-release-linux",
      "configuration": "Release",
      "targets": [
        "signal_siege_package",
        "kin_example_tests",
        "kin_desktop_package_fixture",
        "kin_desktop_package_library",
        "kin_component_tests"
      ]
    },
    {
      "name": "signal-siege-release-windows",
      "configurePreset": "signal-siege-release-windows",
      "configuration": "Release",
      "targets": [
        "signal_siege_package",
        "kin_example_tests",
        "kin_desktop_package_fixture",
        "kin_desktop_package_library",
        "kin_component_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "2d",
      "configurePreset": "2d",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2
      },
      "environment": {
        "KIN_RENDER_BACKEND": "sdl"
      }
    },
    {
      "name": "3d",
      "configurePreset": "3d",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2
      }
    },
