# Invoked after packaging; the report lives outside the ZIP to avoid counting
# itself and to let CI compare builds without extracting them.
function(kin_json_string output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

set(report "{}")
file(SHA256 "${archive}" package_sha)
string(JSON report SET "${report}" package_sha256 "\"${package_sha}\"")
string(JSON report SET "${report}" schema "\"kin.package-size/1\"")
foreach(field NAME TARGET CONFIG SYSTEM ARCHITECTURE COMPILER COMPILER_VERSION)
    string(TOLOWER "${field}" key)
    kin_json_string(value "${KIN_PACKAGE_${field}}")
    string(JSON report SET "${report}" "${key}" "${value}")
endforeach()
kin_json_string(renderer "${KIN_PACKAGE_RENDERER}")
string(JSON report SET "${report}" renderer "${renderer}")
kin_json_string(linux_video "${KIN_PACKAGE_LINUX_VIDEO}")
string(JSON report SET "${report}" linux_video "${linux_video}")
set(drivers "[]")
foreach(driver IN LISTS KIN_PACKAGE_SDL_VIDEO_DRIVERS)
    string(JSON index LENGTH "${drivers}")
    kin_json_string(value "${driver}")
    string(JSON drivers SET "${drivers}" ${index} "${value}")
endforeach()
string(JSON report SET "${report}" sdl_video_drivers "${drivers}")
set(host_libraries "[]")
foreach(pattern IN LISTS KIN_PACKAGE_HOST_LIBRARY_REGEXES)
    string(JSON index LENGTH "${host_libraries}")
    kin_json_string(value "${pattern}")
    string(JSON host_libraries SET "${host_libraries}" ${index} "${value}")
endforeach()
string(JSON report SET "${report}" host_library_regexes "${host_libraries}")
if(KIN_PACKAGE_COMPONENT_MANIFEST)
    file(READ "${KIN_PACKAGE_COMPONENT_MANIFEST}" component_manifest)
    string(JSON components GET "${component_manifest}" components)
    string(JSON report SET "${report}" components "${components}")
endif()
set(features "{}")
foreach(feature SCRIPTING PHYSICS AUDIO SCENE_SERVER DEBUG_OVERLAY RENDER_PROBE DETERMINISM_CHECK PROFILING IMAGE_IO TTF RUNTIME_PROFILING RUNTIME_ASSETS SDL_DYNAMIC_API SDL_GAMEPAD SDL_DESKTOP_SERVICES)
    string(TOLOWER "${feature}" key)
    set(value false)
    if(KIN_SIZE_${feature})
        set(value true)
    endif()
    string(JSON features SET "${features}" "${key}" ${value})
endforeach()
string(JSON report SET "${report}" features "${features}")
set(optimizations "{}")
foreach(option LTO DEAD_STRIPPING)
    string(TOLOWER "${option}" key)
    set(value false)
    if(KIN_SIZE_${option})
        set(value true)
    endif()
    string(JSON optimizations SET "${optimizations}" "${key}" ${value})
endforeach()
set(value false)
if(KIN_PACKAGE_STRIP)
    set(value true)
endif()
string(JSON optimizations SET "${optimizations}" package_strip ${value})
set(value false)
if(KIN_PACKAGE_DEBUG_SYMBOLS)
    set(value true)
endif()
string(JSON optimizations SET "${optimizations}" separate_debug_symbols ${value})
set(value false)
if(KIN_PACKAGE_COOK_TOOL)
    set(value true)
endif()
string(JSON optimizations SET "${optimizations}" asset_cooking ${value})
kin_json_string(value "${KIN_PACKAGE_PGO_MODE}")
string(JSON optimizations SET "${optimizations}" pgo_mode "${value}")
kin_json_string(value "${KIN_PACKAGE_PGO_MANIFEST_SHA256}")
string(JSON optimizations SET "${optimizations}" pgo_manifest_sha256 "${value}")
string(JSON report SET "${report}" optimizations "${optimizations}")

file(SIZE "${KIN_PACKAGE_BUILD_EXECUTABLE}" build_bytes)
file(SIZE "${stage}/${KIN_PACKAGE_EXECUTABLE}" executable_bytes)
file(SIZE "${archive}" archive_bytes)
string(JSON report SET "${report}" build_executable_bytes ${build_bytes})
string(JSON report SET "${report}" packaged_executable_bytes ${executable_bytes})
string(JSON report SET "${report}" archive_bytes ${archive_bytes})

file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${stage}" "${stage}/*")
list(SORT files)
set(entries "[]")
set(total 0)
set(index 0)
foreach(category executable assets libraries licenses metadata)
    set(bytes_${category} 0)
endforeach()
foreach(path IN LISTS files)
    file(SIZE "${stage}/${path}" bytes)
    if(path STREQUAL KIN_PACKAGE_EXECUTABLE)
        set(category executable)
    elseif(path MATCHES "^assets/" OR path MATCHES "\\.kinpak$" OR (KIN_PACKAGE_CONTENT_DIRECTORY AND path MATCHES "^${KIN_PACKAGE_CONTENT_DIRECTORY}/"))
        set(category assets)
    elseif(path MATCHES "^licenses/")
        set(category licenses)
    elseif(path MATCHES "^lib/" OR path MATCHES "\\.[dD][lL][lL]$")
        set(category libraries)
    else()
        set(category metadata)
    endif()
    math(EXPR bytes_${category} "${bytes_${category}} + ${bytes}")
    math(EXPR total "${total} + ${bytes}")
    kin_json_string(quoted_path "${path}")
    set(entry "{\"path\":${quoted_path},\"bytes\":${bytes},\"category\":\"${category}\"}")
    string(JSON entries SET "${entries}" ${index} "${entry}")
    math(EXPR index "${index} + 1")
endforeach()
set(categories "{}")
foreach(category executable assets libraries licenses metadata)
    string(JSON categories SET "${categories}" "${category}" ${bytes_${category}})
endforeach()
string(JSON report SET "${report}" categories "${categories}")
string(JSON report SET "${report}" files "${entries}")
string(JSON report SET "${report}" file_count ${index})
string(JSON report SET "${report}" uncompressed_bytes ${total})
file(WRITE "${stage}.size.json" "${report}\n")
message(STATUS "Package bytes: executable=${executable_bytes}, installed=${total}, zip=${archive_bytes}")
message(STATUS "Size report: ${stage}.size.json")
