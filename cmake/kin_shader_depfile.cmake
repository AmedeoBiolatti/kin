# Older glslc versions emit unescaped spaces in dependency paths. Normalize
# those paths before CMake consumes the Make-format depfile. All inputs are
# absolute paths (kin_compile_glsl passes an absolute source/include directory).
file(READ "${DEPFILE}" dependencies)
string(LENGTH "${OUTPUT}: " prefix_length)
string(SUBSTRING "${dependencies}" ${prefix_length} -1 dependencies)
string(REPLACE "\\\r\n" " " dependencies "${dependencies}")
string(REPLACE "\\\n" " " dependencies "${dependencies}")
string(STRIP "${dependencies}" dependencies)
string(REPLACE "\\ " " " dependencies "${dependencies}")
string(REPLACE " " ";" words "${dependencies}")
set(paths "${OUTPUT}")
set(path "")
foreach(word IN LISTS words)
    if(IS_ABSOLUTE "${word}" AND NOT path STREQUAL "")
        list(APPEND paths "${path}")
        set(path "")
    endif()
    if(path STREQUAL "")
        set(path "${word}")
    else()
        string(APPEND path " ${word}")
    endif()
endforeach()
if(NOT path STREQUAL "")
    list(APPEND paths "${path}")
endif()
set(content "")
foreach(path IN LISTS paths)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Could not read glslc dependency path: ${path}")
    endif()
    string(REPLACE "\\" "/" path "${path}")
    string(REPLACE "$" "$$" path "${path}")
    string(REPLACE "#" "\\#" path "${path}")
    string(REPLACE " " "\\ " path "${path}")
    if(content STREQUAL "")
        set(content "${path}:")
    else()
        string(APPEND content " ${path}")
    endif()
endforeach()
file(WRITE "${DEPFILE}" "${content}\n")
