# Browser stock shaders are GLSL ES source, embedded after host-side includes.
# Native shaders consume the same pure math includes through glslc.
function(_kin_expand_webgl source depth output)
    if(depth GREATER 16)
        message(FATAL_ERROR "WebGL shader include cycle or excessive nesting: ${source}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" text)
    get_filename_component(parent "${source}" DIRECTORY)
    string(REGEX MATCHALL "#[ \t]*include[ \t]+\"[^\"]+\"" includes "${text}")
    math(EXPR next "${depth}+1")
    foreach(include IN LISTS includes)
        string(REGEX REPLACE "^[^\"]*\"([^\"]+)\"$" "\\1" name "${include}")
        if(EXISTS "${parent}/${name}")
            set(path "${parent}/${name}")
        else()
            set(path "${KIN_SHADER_INCLUDE_DIR}/${name}")
        endif()
        _kin_expand_webgl("${path}" ${next} expanded)
        string(REPLACE "${include}" "${expanded}" text "${text}")
    endforeach()
    set(${output} "${text}" PARENT_SCOPE)
endfunction()

function(kin_embed_webgl_shaders target)
    set(files)
    foreach(source IN LISTS ARGN)
        get_filename_component(name "${source}" NAME)
        _kin_expand_webgl("${source}" 0 expanded)
        set(path "${CMAKE_CURRENT_BINARY_DIR}/webgl-shaders/${name}")
        file(CONFIGURE OUTPUT "${path}" CONTENT "${expanded}" @ONLY)
        list(APPEND files "${path}")
    endforeach()
    kin_embed_files(${target} NAME embedded_webgl_shader NAMESPACE kin FILES ${files})
endfunction()
