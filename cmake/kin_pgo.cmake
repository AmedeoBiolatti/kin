include_guard(GLOBAL)
set(KIN_PGO_MODE "off" CACHE STRING "Compiler PGO: off, generate or use")
set_property(CACHE KIN_PGO_MODE PROPERTY STRINGS off generate use)
set(KIN_PGO_DIR "${CMAKE_BINARY_DIR}/pgo" CACHE PATH "Training profiles and compatibility manifest")
if(NOT KIN_PGO_MODE MATCHES "^(off|generate|use)$")
    message(FATAL_ERROR "KIN_PGO_MODE must be off, generate or use")
endif()
if(KIN_PGO_MODE STREQUAL "off")
    return()
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR
   NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$" OR
   NOT CMAKE_C_COMPILER_ID STREQUAL CMAKE_CXX_COMPILER_ID OR
   NOT CMAKE_GENERATOR STREQUAL "Ninja" OR
   NOT CMAKE_BUILD_TYPE MATCHES "^(Release|RelWithDebInfo|MinSizeRel)$")
    message(FATAL_ERROR "Compiler PGO currently requires Linux GNU/Clang, single-config Ninja and an optimized configuration")
endif()
get_filename_component(KIN_PGO_DIR "${KIN_PGO_DIR}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
file(MAKE_DIRECTORY "${KIN_PGO_DIR}/raw")
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(KIN_PGO_GENERATE_FLAG "-fprofile-generate=${KIN_PGO_DIR}/raw")
    set(KIN_PGO_USE_FLAG "-fprofile-use=${KIN_PGO_DIR}/raw")
    # Unexecuted paths (e.g. another GPU/audio driver) retain normal optimization.
    set(KIN_PGO_USE_DIAGNOSTICS -fprofile-partial-training -Werror=coverage-mismatch)
else()
    set(KIN_PGO_GENERATE_FLAG "-fprofile-instr-generate=${KIN_PGO_DIR}/raw/%m-%p.profraw")
    set(KIN_PGO_USE_FLAG "-fprofile-instr-use=${KIN_PGO_DIR}/merged.profdata")
    set(KIN_PGO_USE_DIAGNOSTICS -Werror=profile-instr-out-of-date)
endif()
set(settings "{}")
foreach(key mode compiler compiler_version c_compiler_version configuration build_dir source_dir profile_dir)
    if(key STREQUAL "mode")
        set(value "${KIN_PGO_MODE}")
    elseif(key STREQUAL "compiler")
        set(value "${CMAKE_CXX_COMPILER_ID}")
    elseif(key STREQUAL "compiler_version")
        set(value "${CMAKE_CXX_COMPILER_VERSION}")
    elseif(key STREQUAL "c_compiler_version")
        set(value "${CMAKE_C_COMPILER_VERSION}")
    elseif(key STREQUAL "configuration")
        set(value "${CMAKE_BUILD_TYPE}")
    elseif(key STREQUAL "build_dir")
        set(value "${CMAKE_BINARY_DIR}")
    elseif(key STREQUAL "source_dir")
        set(value "${CMAKE_SOURCE_DIR}")
    else()
        set(value "${KIN_PGO_DIR}")
    endif()
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(JSON settings SET "${settings}" ${key} "\"${value}\"")
endforeach()
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/kin-pgo-settings.json" CONTENT "${settings}\n")
if(KIN_PGO_MODE STREQUAL "use")
    if(NOT EXISTS "${KIN_PGO_DIR}/manifest.json")
        message(FATAL_ERROR "Seal training profiles with tools/pgo_profiles.py before enabling PGO use")
    endif()
    file(SHA256 "${KIN_PGO_DIR}/manifest.json" KIN_PGO_MANIFEST_SHA256)
    add_custom_target(kin_pgo_verify
        COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/pgo_profiles.py"
            verify --build "${CMAKE_BINARY_DIR}" --manifest-sha256 "${KIN_PGO_MANIFEST_SHA256}"
        COMMENT "Checking PGO source, compiler, command and profile compatibility"
        VERBATIM)
endif()
