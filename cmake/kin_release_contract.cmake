include_guard(GLOBAL)
option(KIN_RELEASE_CONTRACT "Enforce the desktop-v1 release architecture and compiler policy" OFF)
if(KIN_RELEASE_CONTRACT)
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
        message(FATAL_ERROR "desktop-v1 requires x86-64")
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR NOT CMAKE_CXX_COMPILER_VERSION MATCHES "^13\\.")
            message(FATAL_ERROR "desktop-v1 Linux releases require GCC 13; use a separate build tree")
        endif()
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
        if(CMAKE_VS_PLATFORM_NAME AND NOT CMAKE_VS_PLATFORM_NAME STREQUAL "x64")
            message(FATAL_ERROR "desktop-v1 Windows releases require the x64 target platform")
        endif()
        if(NOT MSVC OR MSVC_VERSION LESS 1930 OR MSVC_VERSION GREATER_EQUAL 1950)
            message(FATAL_ERROR "desktop-v1 Windows releases require Visual Studio 2022 MSVC")
        endif()
    else()
        message(FATAL_ERROR "desktop-v1 supports Linux and Windows only")
    endif()
endif()
