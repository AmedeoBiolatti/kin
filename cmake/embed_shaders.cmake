cmake_minimum_required(VERSION 3.22)
include("${MANIFEST}")

set(source "// Generated by embed_shaders.cmake.\n#include \"builtin_shaders.hpp\"\n\nnamespace kin::render_detail {\nnamespace {\n")
set(lookup "")
foreach(path IN LISTS KIN_SHADER_FILES)
    get_filename_component(name "${path}" NAME)
    string(MAKE_C_IDENTIFIER "${name}" identifier)
    file(READ "${path}" bytes HEX)
    if(bytes STREQUAL "")
        message(FATAL_ERROR "Cannot embed empty shader: ${path}")
    endif()
    # Keep generated lines short enough for every supported compiler.
    string(REGEX REPLACE "(................................)" "\\1\n" bytes "${bytes}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    string(APPEND source "alignas(4) const u8 ${identifier}[] = {\n${bytes}\n};\n")
    string(APPEND lookup "    if (name == \"${name}\") return ${identifier};\n")
endforeach()
string(APPEND source "} // namespace\n\nstd::span<const u8> builtin_shader_bytes(std::string_view name) {\n    (void)name;\n${lookup}    return {};\n}\n} // namespace kin::render_detail\n")
file(WRITE "${OUTPUT}" "${source}")
