# Values originate in the configured build; no credentials or absolute source
# paths are written to the player artifact.
function(_kin_identity_string output input)
    string(REPLACE "\\" "\\\\" value "${input}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
set(identity "{\"schema\":\"kin.release/1\"}")
foreach(field TARGET VERSION CONFIG SYSTEM ARCHITECTURE COMPILER COMPILER_VERSION SOURCE_REVISION SOURCE_DIRTY)
    string(TOLOWER "${field}" key)
    _kin_identity_string(value "${KIN_PACKAGE_${field}}")
    string(JSON identity SET "${identity}" "${key}" "${value}")
endforeach()
set(static_runtime false)
if(KIN_PACKAGE_STATIC_RUNTIME)
    set(static_runtime true)
endif()
string(JSON identity SET "${identity}" static_runtime ${static_runtime})
set(experimental_3d false)
if(KIN_PACKAGE_EXPERIMENTAL_3D)
    set(experimental_3d true)
endif()
string(JSON identity SET "${identity}" experimental_3d ${experimental_3d})
set(contract "experimental")
if(KIN_PACKAGE_RELEASE_CONTRACT)
    set(contract "desktop-v1")
endif()
string(JSON identity SET "${identity}" contract "\"${contract}\"")
if(KIN_PACKAGE_RELEASE_CONTRACT)
    file(COPY_FILE "${KIN_PACKAGE_CONTRACT_FILE}" "${stage}/PLATFORM.json")
    file(SHA256 "${stage}/PLATFORM.json" contract_sha)
    string(JSON identity SET "${identity}" contract_sha256 "\"${contract_sha}\"")
endif()
if(KIN_PACKAGE_COMPONENT_MANIFEST)
    file(READ "${KIN_PACKAGE_COMPONENT_MANIFEST}" component_manifest)
    string(JSON selected GET "${component_manifest}" components)
    string(JSON identity SET "${identity}" components "${selected}")
endif()
file(WRITE "${stage}/release.json" "${identity}\n")
file(WRITE "${stage}/RUNNING.txt" "${KIN_PACKAGE_TARGET} ${KIN_PACKAGE_VERSION}\nExtract the complete folder, then launch ${KIN_PACKAGE_EXECUTABLE}.\nContract: ${contract}. Each OS/architecture has its own package.\nWindows desktop-v1: Windows 10/11 x64; graphics/audio drivers supplied by the OS.\nLinux desktop-v1: Ubuntu 24.04 x86-64 baseline (glibc 2.39 and the Ubuntu 24.04 libstdc++ runtime).\nA desktop display and graphics/audio drivers remain host prerequisites.\nGPU rendering needs SDL_GPU-compatible drivers.\nExperimental packages do not claim the desktop-v1 baseline until acceptance passes.\n")
if(KIN_PACKAGE_TARGET STREQUAL "signal_siege")
    file(APPEND "${stage}/RUNNING.txt" "Signal Siege bundles its fonts. No compiler, shader compiler, Python or host fonts are required.\nSettings: Windows %APPDATA%/kin/signal_siege; Linux XDG_DATA_HOME/kin/signal_siege (default ~/.local/share/kin/signal_siege).\nKeep the font notices in the content pack (lang/fonts) with the game.\n")
endif()
