# Run after installation, before the player checksum manifest is generated.
set(symbols "${stage}-symbols")
file(REMOVE_RECURSE "${symbols}")
file(MAKE_DIRECTORY "${symbols}")
function(kin_symbol_string output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
set(symbol_manifest "{\"schema\":\"kin.package-symbols/1\",\"files\":[]}")
foreach(field NAME CONFIG SYSTEM ARCHITECTURE COMPILER COMPILER_VERSION SOURCE_REVISION SOURCE_DIRTY PGO_MODE PGO_MANIFEST_SHA256)
    string(TOLOWER "${field}" key)
    kin_symbol_string(value "${KIN_PACKAGE_${field}}")
    string(JSON symbol_manifest SET "${symbol_manifest}" ${key} "${value}")
endforeach()

file(GLOB_RECURSE candidates LIST_DIRECTORIES FALSE RELATIVE "${stage}" "${stage}/*")
list(SORT candidates)
foreach(path IN LISTS candidates)
    file(READ "${stage}/${path}" magic OFFSET 0 LIMIT 4 HEX)
    get_filename_component(name "${path}" NAME)
    set(debug_path "")
    set(status "")
    if(KIN_PACKAGE_MSVC)
        if(name IN_LIST KIN_PACKAGE_OWN_BINARIES)
            list(FIND KIN_PACKAGE_OWN_BINARIES "${name}" index)
            list(GET KIN_PACKAGE_PDBS ${index} pdb)
            if(NOT EXISTS "${pdb}")
                message(FATAL_ERROR "Missing release PDB for ${name}: ${pdb}")
            endif()
            get_filename_component(pdb_name "${pdb}" NAME)
            get_filename_component(binary_directory "${path}" DIRECTORY)
            if(binary_directory)
                set(debug_path "${binary_directory}/${pdb_name}")
            else()
                set(debug_path "${pdb_name}")
            endif()
            get_filename_component(directory "${symbols}/${debug_path}" DIRECTORY)
            file(MAKE_DIRECTORY "${directory}")
            configure_file("${pdb}" "${symbols}/${debug_path}" COPYONLY)
            set(status "pdb")
        elseif(magic MATCHES "^4d5a")
            set(status "external-debug-unavailable")
        else()
            continue()
        endif()
    elseif(magic STREQUAL "7f454c46" OR (KIN_PACKAGE_SYSTEM STREQUAL "Windows" AND magic MATCHES "^4d5a"))
        execute_process(COMMAND "${KIN_PACKAGE_OBJDUMP_TOOL}" -h "${stage}/${path}"
            OUTPUT_VARIABLE sections COMMAND_ERROR_IS_FATAL ANY)
        if(sections MATCHES "[.]debug_info|[.]zdebug_info")
            set(debug_path "${path}.debug")
            get_filename_component(directory "${symbols}/${debug_path}" DIRECTORY)
            file(MAKE_DIRECTORY "${directory}")
            execute_process(COMMAND "${KIN_PACKAGE_OBJCOPY_TOOL}" --only-keep-debug
                "${stage}/${path}" "${symbols}/${debug_path}" COMMAND_ERROR_IS_FATAL ANY)
            set(status "dwarf")
        elseif(name IN_LIST KIN_PACKAGE_OWN_BINARIES)
            message(FATAL_ERROR "${name} has no DWARF information; rebuild with KIN_PACKAGE_DEBUG_SYMBOLS=ON")
        else()
            # Bundled external libraries may already have been stripped by their
            # distributor. Record that limitation rather than inventing symbols.
            set(status "external-debug-unavailable")
        endif()
        if(KIN_PACKAGE_STRIP)
            execute_process(COMMAND "${KIN_PACKAGE_STRIP_TOOL}" --strip-unneeded
                "${stage}/${path}" COMMAND_ERROR_IS_FATAL ANY)
        endif()
        if(debug_path)
            execute_process(COMMAND "${KIN_PACKAGE_OBJCOPY_TOOL}"
                "--add-gnu-debuglink=${symbols}/${debug_path}" "${stage}/${path}"
                COMMAND_ERROR_IS_FATAL ANY)
        endif()
    else()
        continue()
    endif()
    list(APPEND processed_names "${name}")
    file(SHA256 "${stage}/${path}" binary_sha)
    set(entry "{}")
    foreach(field path status binary_sha debug_path)
        kin_symbol_string(value "${${field}}")
        string(JSON entry SET "${entry}" ${field} "${value}")
    endforeach()
    if(debug_path)
        file(SHA256 "${symbols}/${debug_path}" debug_sha)
        kin_symbol_string(value "${debug_sha}")
        string(JSON entry SET "${entry}" debug_sha "${value}")
    endif()
    string(JSON index LENGTH "${symbol_manifest}" files)
    string(JSON symbol_manifest SET "${symbol_manifest}" files ${index} "${entry}")
endforeach()

foreach(name IN LISTS KIN_PACKAGE_OWN_BINARIES)
    if(NOT name IN_LIST processed_names)
        message(FATAL_ERROR "No debug-symbol record for project binary: ${name}")
    endif()
endforeach()
