include_guard(GLOBAL)
if(NOT DEFINED _kin_developer_default)
    set(_kin_developer_default ON)
endif()
if(NOT DEFINED KIN_ENABLE_AGENT_SERVER)
    set(KIN_ENABLE_AGENT_SERVER ${_kin_developer_default})
endif()

# Registration is deliberately separate from resolution: forward dependencies
# are allowed, but unknown, disabled and cyclic requirements fail before fetching.
function(kin_declare_component name)
    get_property(finalized GLOBAL PROPERTY KIN_COMPONENTS_FINALIZED)
    if(finalized)
        message(FATAL_ERROR "Register component ${name} before generating the component configuration")
    endif()
    cmake_parse_arguments(C "LEGACY_PRESENCE" "DESCRIPTION;DEFAULT" "REQUIRES;EXTERNAL_DEPENDENCIES;TESTS" ${ARGN})
    if(C_UNPARSED_ARGUMENTS OR C_KEYWORDS_MISSING_VALUES OR NOT name MATCHES "^[A-Z][A-Z0-9_]*$")
        message(FATAL_ERROR "Invalid component declaration: ${name}")
    endif()
    get_property(names GLOBAL PROPERTY KIN_COMPONENTS)
    if(name IN_LIST names)
        message(FATAL_ERROR "Duplicate Kin component: ${name}")
    endif()
    option(KIN_ENABLE_${name} "${C_DESCRIPTION}" ${C_DEFAULT})
    set_property(GLOBAL APPEND PROPERTY KIN_COMPONENTS "${name}")
    foreach(field DESCRIPTION REQUIRES EXTERNAL_DEPENDENCIES TESTS LEGACY_PRESENCE)
        set_property(GLOBAL PROPERTY KIN_COMPONENT_${name}_${field} "${C_${field}}")
    endforeach()
endfunction()

function(_kin_check_component name chain)
    if(name IN_LIST chain)
        message(FATAL_ERROR "Cyclic Kin component requirements: ${chain};${name}")
    endif()
    list(APPEND chain "${name}")
    get_property(requirements GLOBAL PROPERTY KIN_COMPONENT_${name}_REQUIRES)
    get_property(names GLOBAL PROPERTY KIN_COMPONENTS)
    foreach(requirement IN LISTS requirements)
        if(NOT requirement IN_LIST names)
            message(FATAL_ERROR "Kin component ${name} requires unknown component ${requirement}")
        endif()
        if(KIN_ENABLE_${name} AND NOT KIN_ENABLE_${requirement})
            message(FATAL_ERROR "KIN_ENABLE_${name}=ON requires KIN_ENABLE_${requirement}=ON (chain: ${chain}); enable it explicitly or disable ${name}")
        endif()
        _kin_check_component("${requirement}" "${chain}")
    endforeach()
endfunction()

function(kin_resolve_components)
    get_property(names GLOBAL PROPERTY KIN_COMPONENTS)
    foreach(name IN LISTS names)
        _kin_check_component("${name}" "")
    endforeach()
endfunction()

# Optional game/extension requirements never silently enable a subsystem.
function(kin_require_components target)
    get_property(names GLOBAL PROPERTY KIN_COMPONENTS)
    foreach(name IN LISTS ARGN)
        if(NOT name IN_LIST names)
            message(FATAL_ERROR "${target} requires unknown Kin component ${name}")
        endif()
        if(NOT KIN_ENABLE_${name})
            message(FATAL_ERROR "${target} requires KIN_ENABLE_${name}=ON")
        endif()
    endforeach()
endfunction()

function(_kin_component_json_array output)
    set(result "[]")
    set(index 0)
    foreach(value IN LISTS ARGN)
        # Component/dependency/test identifiers are controlled by declarations.
        if(NOT value MATCHES "^[A-Za-z0-9_.:+-]+$")
            message(FATAL_ERROR "Invalid component metadata identifier: ${value}")
        endif()
        string(JSON result SET "${result}" ${index} "\"${value}\"")
        math(EXPR index "${index} + 1")
    endforeach()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(kin_generate_component_config directory)
    kin_resolve_components()
    if(TARGET kin_component_config)
        message(FATAL_ERROR "Kin component configuration already generated")
    endif()
    set_property(GLOBAL PROPERTY KIN_COMPONENTS_FINALIZED TRUE)
    add_library(kin_component_config INTERFACE)
    add_library(kin::components ALIAS kin_component_config)
    target_compile_features(kin_component_config INTERFACE cxx_std_17)
    target_include_directories(kin_component_config INTERFACE "${directory}/include")
    set(header "#pragma once\n// Generated by kin_components.cmake. One component selection per build.\n")
    set(values "\nnamespace kin::components {\n")
    set(manifest "{\"schema\":\"kin.components/1\",\"components\":{}}")
    get_property(names GLOBAL PROPERTY KIN_COMPONENTS)
    set(enabled_names)
    set(disabled_names)
    foreach(name IN LISTS names)
        string(TOLOWER "${name}" key)
        set(value 0)
        set(boolean false)
        if(KIN_ENABLE_${name})
            set(value 1)
            set(boolean true)
            list(APPEND enabled_names "${key}")
        else()
            list(APPEND disabled_names "${key}")
        endif()
        string(APPEND header "#define KIN_HAS_${name} ${value}\n")
        string(APPEND values "inline constexpr bool ${key} = KIN_HAS_${name};\n")
        get_property(legacy GLOBAL PROPERTY KIN_COMPONENT_${name}_LEGACY_PRESENCE)
        if(legacy)
            # Preserve #ifdef consumers of the two original diagnostic switches.
            if(value)
                target_compile_definitions(kin_component_config INTERFACE KIN_ENABLE_${name})
            endif()
        else()
            target_compile_definitions(kin_component_config INTERFACE KIN_ENABLE_${name}=${value})
        endif()
        set(entry "{\"enabled\":${boolean},\"option\":\"KIN_ENABLE_${name}\"}")
        foreach(field REQUIRES EXTERNAL_DEPENDENCIES TESTS)
            get_property(items GLOBAL PROPERTY KIN_COMPONENT_${name}_${field})
            _kin_component_json_array(array ${items})
            string(TOLOWER "${field}" field_key)
            string(JSON entry SET "${entry}" "${field_key}" "${array}")
        endforeach()
        string(JSON manifest SET "${manifest}" components "${key}" "${entry}")
    endforeach()
    string(APPEND values "}\n")
    file(CONFIGURE OUTPUT "${directory}/include/kin/components.hpp" CONTENT "${header}${values}" @ONLY)
    file(CONFIGURE OUTPUT "${directory}/components.json" CONTENT "${manifest}\n" @ONLY)
    set_property(GLOBAL PROPERTY KIN_COMPONENT_MANIFEST "${directory}/components.json")
    message(STATUS "Kin components enabled: ${enabled_names}")
    message(STATUS "Kin components disabled: ${disabled_names}")
endfunction()

# A single declaration supplies the option, public definitions, manifest and
# test registration. Source/target migration is incremental.
kin_declare_component(SCRIPTING DEFAULT ON DESCRIPTION "Build Lua scripting and scene bindings"
    EXTERNAL_DEPENDENCIES Lua sol2 TESTS kin-lua-script kin-scripting)
kin_declare_component(PHYSICS DEFAULT ON DESCRIPTION "Build Box2D physics and ECS integration"
    EXTERNAL_DEPENDENCIES Box2D TESTS kin-physics kin-ecs-physics kin-physics-component)
kin_declare_component(AUDIO DEFAULT ON DESCRIPTION "Build audio playback, catalogs and ECS integration"
    EXTERNAL_DEPENDENCIES SDL3 TESTS kin-audio kin-audio-component)
kin_declare_component(SCENE_SERVER DEFAULT ${KIN_ENABLE_AGENT_SERVER} DESCRIPTION "Build the scene automation server (--server)" TESTS kin-server)
kin_declare_component(DEBUG_OVERLAY DEFAULT ${_kin_developer_default} DESCRIPTION "Build the runtime debug overlay UI and shortcuts")
kin_declare_component(IMAGE_IO DEFAULT ON DESCRIPTION "Build image file codecs and PNG screenshots"
    EXTERNAL_DEPENDENCIES SDL3_image)
kin_declare_component(TTF DEFAULT ON DESCRIPTION "Build TrueType/OpenType loading and shaping"
    EXTERNAL_DEPENDENCIES SDL3_ttf)
kin_declare_component(RUNTIME_PROFILING DEFAULT ON DESCRIPTION "Build scene runtime profile capture and reports")
kin_declare_component(RUNTIME_ASSETS DEFAULT ON DESCRIPTION "Build scene runtime asset pumping and file watching")
kin_declare_component(RENDER_PROBE DEFAULT ${_kin_developer_default} LEGACY_PRESENCE DESCRIPTION "Build the headless render probe (--probe-render)"
    TESTS kin-render-probe)
kin_declare_component(DETERMINISM_CHECK DEFAULT ${_kin_developer_default} LEGACY_PRESENCE DESCRIPTION "Build the determinism check (--check-determinism)"
    TESTS kin-determinism)
