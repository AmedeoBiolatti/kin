cmake_minimum_required(VERSION 3.22)
set(build "${TEST_DIR}/release-policy")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_DIR}/fixtures/release_policy" -B "${build}"
    -G "${GENERATOR}" "-DCMAKE_BUILD_TYPE=${CONFIG}" "-DKIN_ENABLE_LTO=${LTO}"
    "-DCMAKE_C_COMPILER=${CC}" "-DCMAKE_CXX_COMPILER=${CXX}"
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --config "${CONFIG}"
    --target release_fixture_package COMMAND_ERROR_IS_FATAL ANY)
include("${build}/fixture-package-${CONFIG}.cmake")
if(GENERATOR STREQUAL "Ninja" AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    file(READ "${build}/compile_commands.json" commands)
    foreach(index RANGE 1)
        string(JSON command GET "${commands}" ${index} command)
        foreach(flag -ffunction-sections -fdata-sections -g)
            if(NOT command MATCHES " ${flag}( |$)")
                message(FATAL_ERROR "Missing ${flag} in actual compiler command: ${command}")
            endif()
        endforeach()
        if(LTO AND NOT command MATCHES " -flto")
            message(FATAL_ERROR "Legacy dependency silently lost IPO: ${command}")
        endif()
    endforeach()
endif()
set(stage "${build}/packages/${PACKAGE_NAME}")
set(symbols "${stage}-symbols")
file(READ "${symbols}/manifest.json" report)
string(JSON count LENGTH "${report}" files)
if(count LESS 2)
    message(FATAL_ERROR "Expected symbols for the executable and legacy shared library")
endif()
file(SHA256 "${stage}.zip" actual)
string(JSON expected GET "${report}" package_sha256)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Symbols do not match the player archive")
endif()
file(REMOVE_RECURSE "${build}/relocated game")
file(MAKE_DIRECTORY "${build}/relocated game" "${build}/unrelated cwd")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${stage}.zip"
    WORKING_DIRECTORY "${build}/relocated game" COMMAND_ERROR_IS_FATAL ANY)
set(relocated "${build}/relocated game/${PACKAGE_NAME}")
execute_process(COMMAND "${relocated}/${EXECUTABLE}"
    WORKING_DIRECTORY "${build}/unrelated cwd" COMMAND_ERROR_IS_FATAL ANY)
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    foreach(field path debug_path binary_sha)
        string(JSON ${field} GET "${report}" files ${index} ${field})
    endforeach()
    file(SHA256 "${relocated}/${path}" actual)
    if(NOT actual STREQUAL binary_sha)
        message(FATAL_ERROR "Incorrect binary digest: ${path}")
    endif()
    if(NOT debug_path)
        continue()
    endif()
    string(JSON debug_sha GET "${report}" files ${index} debug_sha)
    file(SHA256 "${symbols}/${debug_path}" actual)
    if(NOT actual STREQUAL debug_sha OR EXISTS "${relocated}/${debug_path}")
        message(FATAL_ERROR "Incorrect or accidentally shipped symbols: ${debug_path}")
    endif()
    get_filename_component(directory "${relocated}/${debug_path}" DIRECTORY)
    file(COPY "${symbols}/${debug_path}" DESTINATION "${directory}")
endforeach()
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    find_program(gdb gdb)
    if(gdb)
        execute_process(COMMAND "${gdb}" -nx -batch -ex "info line main"
            "${relocated}/${EXECUTABLE}" OUTPUT_VARIABLE lines COMMAND_ERROR_IS_FATAL ANY)
        if(NOT lines MATCHES "main.cpp")
            message(FATAL_ERROR "Separate debug link did not resolve source lines: ${lines}")
        endif()
    endif()
endif()
