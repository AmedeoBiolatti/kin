cmake_minimum_required(VERSION 3.22)

# Generate the package twice: stale files from an older export must not survive.
file(SHA256 "${BUILD_EXECUTABLE}" original_digest)
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${PACKAGE_SCRIPT}" COMMAND_ERROR_IS_FATAL ANY)
set(stage "${BUILD_DIR}/packages/${PACKAGE_NAME}")
file(WRITE "${stage}/stale-from-previous-export.txt" "must not ship")
if(DEBUG_SYMBOLS)
    file(WRITE "${stage}-symbols/stale-from-previous-export.txt" "must not archive")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${PACKAGE_SCRIPT}" COMMAND_ERROR_IS_FATAL ANY)
if(EXISTS "${stage}/stale-from-previous-export.txt" OR
    EXISTS "${stage}-symbols/stale-from-previous-export.txt")
    message(FATAL_ERROR "Package kept a stale file")
endif()
file(SHA256 "${BUILD_EXECUTABLE}" after_digest)
if(NOT original_digest STREQUAL after_digest)
    message(FATAL_ERROR "Packaging changed the build executable")
endif()

# Measure actual shipped bytes, including the checksum manifest. A regression in
# categorization or stripping must not make the report disagree with the files.
file(READ "${stage}.size.json" report)
string(JSON schema GET "${report}" schema)
if(NOT schema STREQUAL "kin.package-size/1")
    message(FATAL_ERROR "Invalid package size schema")
endif()
file(READ "${stage}.components.json" component_report)
string(JSON component_schema GET "${component_report}" schema)
string(JSON component_zip_sha GET "${component_report}" package_sha256)
file(SHA256 "${stage}.zip" actual_component_zip_sha)
if(NOT component_schema STREQUAL "kin.components/1" OR
    NOT component_zip_sha STREQUAL actual_component_zip_sha)
    message(FATAL_ERROR "Component manifest does not identify the player ZIP")
endif()
string(JSON component_count LENGTH "${component_report}" components)
math(EXPR component_last "${component_count} - 1")
foreach(index RANGE ${component_last})
    string(JSON component MEMBER "${component_report}" components ${index})
    string(JSON enabled GET "${component_report}" components ${component} enabled)
    string(JSON measured GET "${report}" components ${component} enabled)
    if(NOT enabled STREQUAL measured)
        message(FATAL_ERROR "Component metadata mismatch: ${component}")
    endif()
endforeach()
if(EXISTS "${stage}/components.json")
    message(FATAL_ERROR "Build component manifest leaked into the player package")
endif()
file(READ "${stage}.release.json" release_report)
string(JSON release_zip_sha GET "${release_report}" package_sha256)
string(JSON release_version GET "${release_report}" version)
file(SHA256 "${stage}.zip" actual_release_sha)
if(NOT release_zip_sha STREQUAL actual_release_sha OR NOT release_version MATCHES "^[0-9]+[.][0-9]+[.][0-9]+")
    message(FATAL_ERROR "Release identity does not match the versioned artifact")
endif()
file(READ "${stage}/release.json" player_identity)
string(JSON player_version GET "${player_identity}" version)
if(NOT player_version STREQUAL release_version)
    message(FATAL_ERROR "Player release identity disagrees with the sidecar")
endif()
string(JSON sdl_dynamic_api GET "${report}" features sdl_dynamic_api)
if(sdl_dynamic_api)
    if(EXISTS "${stage}/licenses/SDL3/KIN-SDL-CHANGES.txt")
        message(FATAL_ERROR "Default SDL package contains a private variant notice")
    endif()
else()
    file(READ "${stage}/licenses/SDL3/KIN-SDL-CHANGES.txt" sdl_changes)
    if(NOT sdl_changes MATCHES "SDL_DYNAMIC_API.*1 to 0")
        message(FATAL_ERROR "Private SDL variant notice missing its source modification")
    endif()
endif()
foreach(dependency lua sol2 box2d SDL3_image SDL3_ttf)
    set(feature scripting)
    if(dependency STREQUAL "box2d")
        set(feature physics)
    elseif(dependency STREQUAL "SDL3_image")
        set(feature image_io)
    elseif(dependency STREQUAL "SDL3_ttf")
        set(feature ttf)
    endif()
    string(JSON enabled GET "${report}" features ${feature})
    if(NOT enabled AND EXISTS "${stage}/licenses/${dependency}")
        message(FATAL_ERROR "Disabled dependency still packaged: ${dependency}")
    endif()
endforeach()
string(JSON image_io GET "${report}" features image_io)
if(image_io)
    file(READ "${stage}/licenses/SDL3_image/stb-LICENSE.txt" stb_notice)
    if(NOT stb_notice MATCHES "Copyright.*Sean Barrett" OR NOT stb_notice MATCHES "THE SOFTWARE IS PROVIDED")
        message(FATAL_ERROR "Incomplete stb notice")
    endif()
    if(EXISTS "${stage}/licenses/SDL3_image/src/stb_image.h")
        message(FATAL_ERROR "Package includes codec implementation as a license")
    endif()
endif()
string(JSON file_count GET "${report}" file_count)
string(JSON entries LENGTH "${report}" files)
if(NOT file_count EQUAL entries)
    message(FATAL_ERROR "Size report file count mismatch")
endif()
math(EXPR last "${entries} - 1")
set(actual_total 0)
foreach(i RANGE ${last})
    string(JSON path GET "${report}" files ${i} path)
    string(JSON expected GET "${report}" files ${i} bytes)
    file(SIZE "${stage}/${path}" actual)
    if(NOT expected EQUAL actual)
        message(FATAL_ERROR "Size mismatch for ${path}")
    endif()
    math(EXPR actual_total "${actual_total} + ${actual}")
endforeach()
set(category_total 0)
foreach(category executable assets libraries licenses metadata)
    string(JSON bytes GET "${report}" categories ${category})
    math(EXPR category_total "${category_total} + ${bytes}")
endforeach()
string(JSON expected_total GET "${report}" uncompressed_bytes)
if(NOT actual_total EQUAL expected_total OR NOT category_total EQUAL expected_total)
    message(FATAL_ERROR "Size report totals disagree")
endif()
file(SIZE "${stage}.zip" archive_bytes)
file(READ "${stage}.assets.json" asset_report)
string(JSON asset_valid GET "${asset_report}" valid)
string(JSON pruning_applied GET "${asset_report}" pruning_applied)
string(JSON asset_bytes GET "${asset_report}" totals bytes)
string(JSON expected_zip_sha GET "${asset_report}" package_sha256)
file(SHA256 "${stage}.zip" actual_zip_sha)
set(actual_asset_bytes 0)
file(GLOB_RECURSE audit_assets LIST_DIRECTORIES FALSE "${stage}/assets/package_fixture/*")
foreach(path IN LISTS audit_assets)
    file(SIZE "${path}" bytes)
    math(EXPR actual_asset_bytes "${actual_asset_bytes} + ${bytes}")
endforeach()
string(JSON candidate_bytes GET "${asset_report}" totals unused_candidate bytes)
file(SIZE "${stage}/assets/package_fixture/unused.txt" expected_candidate_bytes)
if(NOT asset_valid OR pruning_applied OR NOT asset_bytes EQUAL actual_asset_bytes OR
    NOT expected_zip_sha STREQUAL actual_zip_sha OR NOT candidate_bytes EQUAL expected_candidate_bytes)
    message(FATAL_ERROR "Asset audit does not match staged content and final ZIP")
endif()
if(EXISTS "${stage}/assets.manifest.json" OR EXISTS "${stage}/asset-report.json")
    message(FATAL_ERROR "Build-only asset declarations/reports leaked into the player package")
endif()
string(JSON expected_archive GET "${report}" archive_bytes)
if(NOT archive_bytes EQUAL expected_archive)
    message(FATAL_ERROR "ZIP size report mismatch")
endif()

set(scratch "${TEST_DIR}/desktop-package-${CONFIG}")
file(REMOVE_RECURSE "${scratch}")
file(MAKE_DIRECTORY "${scratch}/unpacked" "${scratch}/unrelated cwd")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${stage}.zip"
    WORKING_DIRECTORY "${scratch}/unpacked" COMMAND_ERROR_IS_FATAL ANY)
set(relocated "${scratch}/relocated game")
file(RENAME "${scratch}/unpacked/${PACKAGE_NAME}" "${relocated}")
if(DEBUG_SYMBOLS)
    file(MAKE_DIRECTORY "${scratch}/symbols")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${stage}-symbols.zip"
        WORKING_DIRECTORY "${scratch}/symbols" COMMAND_ERROR_IS_FATAL ANY)
    set(symbols "${scratch}/symbols/${PACKAGE_NAME}-symbols")
    file(READ "${symbols}/manifest.json" symbols_report)
    string(JSON symbol_schema GET "${symbols_report}" schema)
    if(NOT symbol_schema STREQUAL "kin.package-symbols/1")
        message(FATAL_ERROR "Invalid symbols manifest")
    endif()
    string(JSON expected GET "${symbols_report}" package_sha256)
    file(SHA256 "${stage}.zip" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Symbols do not match the player archive")
    endif()
    string(JSON count LENGTH "${symbols_report}" files)
    if(count LESS 2)
        message(FATAL_ERROR "Missing executable or shared-library symbol records")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON path GET "${symbols_report}" files ${index} path)
        string(JSON expected GET "${symbols_report}" files ${index} binary_sha)
        file(SHA256 "${relocated}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Symbols binary hash mismatch: ${path}")
        endif()
        string(JSON debug_path GET "${symbols_report}" files ${index} debug_path)
        if(debug_path)
            string(JSON expected GET "${symbols_report}" files ${index} debug_sha)
            file(SHA256 "${symbols}/${debug_path}" actual)
            if(NOT actual STREQUAL expected OR EXISTS "${relocated}/${debug_path}")
                message(FATAL_ERROR "Invalid or accidentally shipped debug artifact: ${debug_path}")
            endif()
            # Only the debugger test gets symbols beside its relocated binaries.
            get_filename_component(directory "${relocated}/${debug_path}" DIRECTORY)
            file(COPY "${symbols}/${debug_path}" DESTINATION "${directory}")
        endif()
    endforeach()
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        find_program(gdb gdb)
        if(gdb)
            execute_process(COMMAND "${gdb}" -nx -batch
                -ex "info line main" "${relocated}/${EXECUTABLE}"
                OUTPUT_VARIABLE lines RESULT_VARIABLE result)
            if(NOT result EQUAL 0 OR NOT lines MATCHES "desktop_package_fixture.cpp")
                message(FATAL_ERROR "Debugger could not resolve source lines through separate symbols: ${lines}")
            endif()
        endif()
    endif()
endif()
foreach(required SHA256SUMS licenses/kin/LICENSE assets/package_fixture/marker.txt assets/package_fixture/unused.txt)
    if(NOT EXISTS "${relocated}/${required}")
        message(FATAL_ERROR "Missing package content: ${required}")
    endif()
endforeach()
file(STRINGS "${relocated}/SHA256SUMS" manifest)
foreach(entry IN LISTS manifest)
    string(SUBSTRING "${entry}" 0 64 expected)
    string(SUBSTRING "${entry}" 66 -1 path)
    file(SHA256 "${relocated}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Package checksum mismatch: ${path}")
    endif()
endforeach()
string(JSON renderer_profile GET "${report}" renderer)
set(backend sdl)
if(renderer_profile STREQUAL "compact")
    set(backend compact)
endif()
set(arguments)
if(renderer_profile STREQUAL "gpu" OR (renderer_profile STREQUAL "auto" AND
    DEFINED ENV{KIN_REQUIRE_GPU_TESTS} AND NOT "$ENV{KIN_REQUIRE_GPU_TESTS}" STREQUAL "0"
    AND NOT "$ENV{KIN_REQUIRE_GPU_TESTS}" STREQUAL ""))
    set(backend gpu)
    set(arguments --gpu)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KIN_RENDER_BACKEND=${backend}"
    "${relocated}/${EXECUTABLE}" ${arguments}
    WORKING_DIRECTORY "${scratch}/unrelated cwd"
    COMMAND_ERROR_IS_FATAL ANY TIMEOUT 60)
# Losing an asset must be an observable failure, even on the build machine.
file(REMOVE "${relocated}/assets/package_fixture/marker.txt")
execute_process(COMMAND "${relocated}/${EXECUTABLE}"
    WORKING_DIRECTORY "${scratch}/unrelated cwd" RESULT_VARIABLE missing TIMEOUT 20)
if(missing STREQUAL "0")
    message(FATAL_ERROR "Package unexpectedly succeeded without its assets")
endif()
