{
 "schema": "kin.material-graph/1",
 "name": "Iridescent pearl",
 "parameters": [
  {
   "name": "pearl",
   "type": "color",
   "default": [
    0.86,
    0.84,
    0.92,
    1
   ]
  },
  {
   "name": "play",
   "type": "float",
   "default": 0.75
  }
 ],
 "nodes": [
  {
   "id": "edge",
   "type": "fresnel",
   "inputs": {
    "power": 1.6,
    "normal": "surface.normal"
   }
  },
  {
   "id": "film",
   "type": "glsl",
   "glsl": "0.5 + 0.5 * cos(6.2832 * (h * 1.4 + p * 0.3 + vec3(0.0, 0.33, 0.67)))",
   "result": "vec3",
   "inputs": {
    "h": "edge",
    "p": "position.y"
   }
  },
  {
   "id": "colour",
   "type": "mix",
   "inputs": {
    "a": "pearl.rgb",
    "b": "film",
    "t": "play"
   }
  }
 ],
 "outputs": {
  "base_color": "colour",
  "metallic": 1.0,
  "roughness": 0.12
 }
}
