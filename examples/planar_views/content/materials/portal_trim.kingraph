{
 "schema": "kin.material-graph/1",
 "name": "Portal trim",
 "parameters": [
  {
   "name": "glow",
   "type": "color",
   "default": [
    0.15,
    1.4,
    1.2,
    1
   ]
  },
  {
   "name": "stone",
   "type": "color",
   "default": [
    0.05,
    0.05,
    0.06,
    1
   ]
  }
 ],
 "nodes": [
  {
   "id": "rise",
   "type": "multiply",
   "inputs": {
    "a": "time",
    "b": 2.5
   }
  },
  {
   "id": "height",
   "type": "multiply",
   "inputs": {
    "a": "position.y",
    "b": 9.0
   }
  },
  {
   "id": "phase",
   "type": "subtract",
   "inputs": {
    "a": "height",
    "b": "rise"
   }
  },
  {
   "id": "wave",
   "type": "sin",
   "inputs": {
    "x": "phase"
   }
  },
  {
   "id": "band",
   "type": "smoothstep",
   "inputs": {
    "edge0": 0.55,
    "edge1": 0.98,
    "x": "wave"
   }
  },
  {
   "id": "cells",
   "type": "noise_cellular",
   "inputs": {
    "p": "position",
    "scale": 7.0
   }
  },
  {
   "id": "rune",
   "type": "smoothstep",
   "inputs": {
    "edge0": 0.22,
    "edge1": 0.08,
    "x": "cells"
   }
  },
  {
   "id": "runes",
   "type": "multiply",
   "inputs": {
    "a": "rune",
    "b": 0.6
   }
  },
  {
   "id": "pattern",
   "type": "add",
   "inputs": {
    "a": "band",
    "b": "runes"
   }
  },
  {
   "id": "strength",
   "type": "remap",
   "inputs": {
    "x": "pattern",
    "in_min": 0.0,
    "in_max": 1.6,
    "out_min": 0.15,
    "out_max": 2.4
   }
  },
  {
   "id": "light",
   "type": "multiply",
   "inputs": {
    "a": "glow.rgb",
    "b": "strength"
   }
  }
 ],
 "outputs": {
  "base_color": "stone.rgb",
  "emission": "light",
  "roughness": 0.35,
  "metallic": 0.2
 }
}
