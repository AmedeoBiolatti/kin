  "reproduction_sources": {
    "probe_cpp": "#include <kin/ecs/ui2.hpp>\n#include <algorithm>\n#include <cassert>\n#include <chrono>\n#include <iostream>\n#include <string>\n#include <vector>\nint main(int argc,char**argv) {\n    kin::EcsWorld world;\n    kin::register_ui2_components(world);\n    if(argc>1 && std::string(argv[1])==\"bench\") {\n        auto root=world.raw().entity().set(kin::Ui2Root{{0,0,100,100}});\n        auto child=world.raw().entity().child_of(root);\n        std::vector<double> samples;\n        for(int r=0;r<33;++r) {\n            auto start=std::chrono::steady_clock::now();\n            for(int i=0;i<100000;++i) {child.add<kin::ui2::Label>();child.remove<kin::ui2::Label>();}\n            if(r>=3)samples.push_back(std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count());\n        }\n        assert(root.get<kin::Ui2LayoutCache>()->tree_version==6600003);\n        std::sort(samples.begin(),samples.end());\n        std::cout<<\"add_remove_100000_ms \"<<samples[samples.size()/2]<<'\\n';\n        return 0;\n    }\n    world.raw().each(flecs::Observer,[&](flecs::entity e) {\n        std::string name=e.name().c_str();if(!name.starts_with(\"ui2_dirty_\"))return;\n        const auto* o=ecs_observer_get(world.raw().c_ptr(),e.id());assert(o&&o->query);\n        const auto* q=o->query;\n        std::cout<<name<<' '<<e.id()<<' '<<o->event_count;\n        for(int i=0;i<o->event_count;++i)std::cout<<' '<<o->events[i];\n        std::cout<<' '<<int(q->term_count)<<' '<<int(q->field_count)<<' '<<q->flags<<' '<<q->read_fields<<' '<<q->write_fields<<' '<<q->data_fields;\n        for(int i=0;i<q->term_count;++i) {\n            const auto&t=q->terms[i];\n            std::cout<<' '<<t.id<<' '<<t.src.id<<' '<<t.first.id<<' '<<t.second.id<<' '<<t.trav<<' '<<t.inout<<' '<<t.oper<<' '<<int(t.field_index)<<' '<<t.flags_;\n        }\n        std::cout<<'\\n';\n    });\n}\n",
    "compile_measurement_python": "import json,pathlib,shlex,subprocess\nbase=pathlib.Path('/mnt/windows/Users/amedeo/Desktop/gamedev');out=base/'kin-build-time-ui2-profile';rows=[]\nfor run in range(3):\n for compiler in (['clang','gcc'] if run%2==0 else ['gcc','clang']):\n  for phase in (['before','after'] if run%2==0 else ['after','before']):\n   name=('kin-build-time-before-'+compiler) if phase=='before' else ('kin-build-time-out' if compiler=='gcc' else 'kin-build-time-clang')\n   b=base/name;e=next(e for e in json.loads((b/'compile_commands.json').read_text()) if e['file'].endswith('/ecs/ui2.cpp'))\n   args=shlex.split(e['command']);label=f'paired-{compiler}-{phase}-{run}';args[args.index('-o')+1]=str(out/(label+'.o'));stats=out/(label+'.stats.json')\n   with (out/(label+'.log')).open('w') as log:\n    p=subprocess.run(['/usr/bin/time','-f','{\"wall_seconds\":%e,\"user_seconds\":%U,\"system_seconds\":%S,\"max_rss_kib\":%M}','-o',str(stats),'taskset','-c','2',*args],cwd=b,stdout=log,stderr=subprocess.STDOUT)\n   if p.returncode:print(log.read_text()[-5000:],flush=True);raise SystemExit(p.returncode)\n   r={'compiler':compiler,'phase':phase,'run':run,**json.loads(stats.read_text())};rows.append(r);print(json.dumps(r),flush=True)\n   pathlib.Path('/tmp/kin-build-bench/ui2-compile-results.json').write_text(json.dumps(rows,indent=2)+'\\n')\n",
    "runtime_measurement_python": "import json,pathlib,subprocess,time\nbase=pathlib.Path('/mnt/windows/Users/amedeo/Desktop/gamedev/kin-build-time-ui2-profile');rows=[]\nwarm_until=time.monotonic()+5\nwhile time.monotonic()<warm_until:\n subprocess.run(['taskset','-c','2',str(base/'clang-after-probe'),'bench'],check=True,capture_output=True)\nfor run in range(3):\n for phase in (['before','after'] if run%2==0 else ['after','before']):\n  p=subprocess.run(['taskset','-c','2',str(base/f'clang-{phase}-probe'),'bench'],check=True,capture_output=True,text=True)\n  name,value=p.stdout.split();r={'phase':phase,'run':run,name:float(value)};rows.append(r);print(json.dumps(r),flush=True)\npathlib.Path('/tmp/kin-build-bench/ui2-runtime-results.json').write_text(json.dumps(rows,indent=2)+'\\n')\n",
    "probe_build_python": "import json,pathlib,shlex,subprocess,sys\nphase=sys.argv[1];compiler=sys.argv[2] if len(sys.argv)>2 else 'clang'\nbase=pathlib.Path('/mnt/windows/Users/amedeo/Desktop/gamedev');b=base/('kin-build-time-out' if compiler=='gcc' else 'kin-build-time-clang')\nout=base/'kin-build-time-ui2-profile';out.mkdir(exist_ok=True);label=compiler+'-'+phase+'-probe'\ne=next(e for e in json.loads((b/'compile_commands.json').read_text()) if e['file'].endswith('/tests/ui2_tests.cpp'))\ncmd=shlex.split(e['command']);cmd[cmd.index('-o')+1]=str(out/(label+'.o'));cmd[cmd.index('-c')+1]='/tmp/kin-build-bench/ui2_probe.cpp'\nsubprocess.run(cmd,cwd=b,check=True)\nlines=subprocess.check_output(['ninja','-C',str(b),'-t','commands','kin_ui2_tests'],text=True).splitlines()\nargs=shlex.split(next(l for l in lines if '-o bin/kin_ui2_tests ' in l));start=next(i for i,x in enumerate(args) if x in ['/usr/bin/c++','/usr/bin/clang++']);end=next((i for i in range(start,len(args)) if args[i]=='&&'),len(args));args=args[start:end]\nargs[args.index('-o')+1]=str(out/label);args[args.index('tests/CMakeFiles/kin_ui2_tests.dir/ui2_tests.cpp.o')]=str(out/(label+'.o'))\nif phase=='before':args.insert(args.index(str(out/(label+'.o'))),str(out/(compiler+'-before.o')))\nsubprocess.run(args,cwd=b,check=True)\nresult=subprocess.check_output([str(out/label)],text=True);(out/(label+'.txt')).write_text(''.join(sorted(result.splitlines(True))))\nprint(label,len(result.splitlines()),'observers',flush=True)\n",
